{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuditLab submission v1.0.0",
  "type": "object", "additionalProperties": false,
  "required": ["episode_id", "findings"],
  "properties": {
    "episode_id": {"type": "string"},
    "findings": {
      "type": "array", "maxItems": 30,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["type", "affected_ids", "claimed_amount_minor", "currency", "evidence_ids", "explanation"],
        "properties": {
          "type": {"enum": ["duplicate_invoice", "payment_allocation", "fx_conversion", "period_cutoff"]},
          "affected_ids": {"type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 100}},
          "claimed_amount_minor": {"type": "integer", "minimum": 0, "maximum": 1000000000000000000},
          "currency": {"type": "string", "minLength": 3, "maxLength": 3},
          "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 100}},
          "explanation": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    }
  }
}
